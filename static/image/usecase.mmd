        UC1(["UC1<br/>上传种子材料<br/>构建知识图谱"])
        UC2(["UC2<br/>配置仿真环境<br/>生成数字人设"])
        UC3(["UC3<br/>启动并监控<br/>群体仿真"])
        UC4(["UC4<br/>生成预测<br/>分析报告"])
        UC5(["UC5<br/>与虚拟智能体<br/>深度对话"])
        UC6(["UC6<br/>查看历史<br/>项目档案"])
        UC7(["UC7<br/>注入上帝视角<br/>外部变量"])
        UC8(["UC8<br/>查看可视化<br/>知识图谱"])
    end

    LLM[/"LLM API<br/>(Qwen / GPT)"/]
